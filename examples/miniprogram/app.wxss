page {
  background: #f5f7f6;
  color: #202b26;
  font-size: 28rpx;
  min-height: 100vh;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
  letter-spacing: 0;
}

.btn {
  margin: 24rpx;
  background: #167753;
  color: #fff;
}

.err {
  color: #b43e3e;
  padding: 24rpx;
}

.hint {
  color: #67726f;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
}

.text-button {
  flex-shrink: 0;
  margin: 0 0 0 24rpx;
  padding: 12rpx 0 12rpx 12rpx;
  background: transparent;
  color: #167753;
  font-size: 26rpx;
  line-height: 1.6;
  border-radius: 0;
}

.text-button::after,
.feed-button::after {
  border: none;
}

.camera-selection {
  margin: 32rpx;
}

.live-page .camera-selection {
  margin: 32rpx 0;
}

.picker-label {
  display: block;
  margin-bottom: 16rpx;
  color: #67726f;
  font-size: 24rpx;
}

.camera-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 16rpx 24rpx;
  border: 1rpx solid #bfcfc7;
  border-radius: 12rpx;
  background: #fff;
  box-sizing: border-box;
}

.picker-value {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.picker-arrow {
  flex-shrink: 0;
  margin-left: 20rpx;
  color: #167753;
}
