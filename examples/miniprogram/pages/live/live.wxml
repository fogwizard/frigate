<view class="live-page">
  <view class="identity">
    <view class="identity-copy">
      <text class="eyebrow">{{isAdmin ? '管理员' : '微信身份'}} · OpenID</text>
      <text class="identity-value" selectable>{{openid || (camerasLoading ? '正在登录' : '未登录')}}</text>
    </view>
  </view>

  <view class="camera-selection">
    <text class="picker-label">{{isAdmin ? '全部镜头' : '寄养号码 / 镜头'}} · {{cameras.length}} 个</text>
    <picker mode="selector" range="{{cameras}}" range-key="label" value="{{cameraIndex}}" bindchange="selectCamera" disabled="{{!cameras.length || camerasLoading || feeding || watering}}">
      <view class="camera-picker">
        <text class="picker-value">{{cameras.length ? cameras[cameraIndex].label : (camerasLoading ? '正在加载镜头' : '暂无已授权镜头')}}</text>
        <text class="picker-arrow">⌄</text>
      </view>
    </picker>
  </view>

  <view class="video-section">
    <view class="section-heading">
      <text class="device-name">{{camera || '实时画面'}}</text>
      <view class="stream-status {{playing ? 'is-online' : ''}}">
        <view class="status-dot"></view>
        <text>{{playing ? '直播中' : (error || !camera ? '未连接' : '连接中')}}</text>
      </view>
    </view>
    <view class="video-frame">
      <live-player
        wx:if="{{flvUrl}}"
        id="player"
        class="player"
        src="{{flvUrl}}"
        mode="live"
        autoplay
        muted
        object-fit="contain"
        bindstatechange="onState"
        binderror="onPlayerError"
      />
      <view wx:else class="video-placeholder">
        <text>{{loading ? '正在连接视频' : '暂无视频画面'}}</text>
      </view>
    </view>
    <view class="video-footer">
      <text class="video-message {{error ? 'error-text' : ''}}">{{error || (playing ? '实时视频' : '等待视频画面')}}</text>
      <button class="text-button" bindtap="refresh" loading="{{loading || camerasLoading}}" disabled="{{loading || camerasLoading || feeding || watering}}">刷新画面</button>
    </view>
  </view>

  <view wx:if="{{!isAdmin || canControl}}" class="feeding-section">
    <text class="section-title">喂食控制</text>
    <button class="feed-button" bindtap="manualFeed" loading="{{feeding}}" disabled="{{!feedConfigured || !camera || feeding || cooldown}}">
      {{feeding ? '正在提交' : (cooldown ? '请稍候' : '手动喂食')}}
    </button>
    <text class="feed-status" aria-live="polite">{{feedConfigured ? feedStatus : '喂食服务未接入'}}</text>
  </view>
  <view wx:if="{{!isAdmin || canControl}}" class="feeding-section">
    <text class="section-title">喂水控制</text>
    <button class="feed-button water-button" bindtap="manualWater" loading="{{watering}}" disabled="{{!waterConfigured || !camera || watering || waterCooldown}}">
      {{watering ? '正在提交' : (waterCooldown ? '请稍候' : '手动喂水')}}
    </button>
    <text class="feed-status" aria-live="polite">{{waterConfigured ? waterStatus : '喂水服务未接入'}}</text>
  </view>
</view>
