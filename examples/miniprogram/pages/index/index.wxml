<view class="account-bar">
  <view class="account-copy">
    <text class="hint">微信 OpenID</text>
    <text class="account-id">{{loginBusy ? '正在登录' : (loggedIn ? '已登录' : '未登录')}}</text>
    <text wx:if="{{loggedIn && phone}}" class="openid-line" selectable>手机号 {{phone}}</text>
  </view>
  <view wx:if="{{loggedIn && !phone}}" class="contact-card">
    <text class="hint">门店按手机号登记寄养。请填写和门店一致的手机号。</text>
    <input class="contact-input" type="number" maxlength="11" placeholder="手机号" value="{{phoneDraft}}" bindinput="onPhone"/>
    <button class="login-button contact-save" bindtap="saveContact" loading="{{contactBusy}}" disabled="{{contactBusy}}">保存手机号</button>
  </view>
  <button class="login-button" bindtap="loginWithWechat" loading="{{loginBusy}}" disabled="{{loginBusy}}">
    {{loggedIn ? '重新登录' : '微信登录'}}
  </button>
</view>

<view class="services">
  <text class="list-heading">服务</text>
  <view class="service-card primary" bindtap="openMyBoarding">
    <text class="service-name">我的寄养</text>
    <text class="service-desc">{{isAdmin ? '查看全部镜头' : (cameras.length ? cameras.length + ' 个有效寄养' : '查看寄养记录')}}</text>
  </view>
  <view class="service-card" bindtap="openLive">
    <text class="service-name">实时画面</text>
    <text class="service-desc">查看寄养间镜头</text>
  </view>
</view>

<view class="list-heading">{{isAdmin ? '管理员 · 全部镜头' : '寄养记录'}} · {{cameras.length}} 个镜头</view>

<view wx:if="{{error}}" class="err">{{error}}</view>
<view wx:if="{{!loading && !error && !cameras.length}}" class="hint">{{isAdmin ? '暂无可查看镜头，请联系门店配置' : '暂无有效寄养记录，请让门店按手机号登记'}}</view>

<view wx:if="{{cameras.length}}" class="camera-selection">
  <text class="picker-label">{{isAdmin ? '镜头编号' : '寄养号码 / 镜头'}}</text>
  <picker mode="selector" range="{{cameras}}" range-key="label" value="{{cameraIndex}}" bindchange="selectCamera" disabled="{{loading}}">
    <view class="camera-picker">
      <text class="picker-value">{{cameras[cameraIndex].label}}</text>
      <text class="picker-arrow">⌄</text>
    </view>
  </picker>
  <button class="btn" bindtap="openLive" disabled="{{loading}}">打开镜头</button>
</view>

<button class="btn" bindtap="reload" loading="{{loading}}" disabled="{{loading}}">刷新设备</button>
