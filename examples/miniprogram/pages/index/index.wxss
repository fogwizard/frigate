.account-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #dce2e0;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-copy .hint {
  display: block;
  padding: 0 0 10rpx;
}

.account-id {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
}

.openid-line {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #67726f;
  word-break: break-all;
}

.login-button {
  flex-shrink: 0;
  margin: 0 0 0 24rpx;
  min-height: 72rpx;
  line-height: 72rpx;
  padding: 0 28rpx;
  background: #167753;
  color: #fff;
  font-size: 26rpx;
  border-radius: 12rpx;
}

.login-button::after {
  border: none;
}

.services {
  padding-bottom: 8rpx;
}

.service-card {
  margin: 0 32rpx 20rpx;
  padding: 28rpx 32rpx;
  background: #fff;
  border: 1rpx solid #dce2e0;
  border-radius: 16rpx;
}

.service-card.primary {
  background: #167753;
  border-color: #167753;
}

.service-name {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
}

.service-card.primary .service-name,
.service-card.primary .service-desc {
  color: #fff;
}

.service-desc {
  display: block;
  margin-top: 8rpx;
  color: #67726f;
  font-size: 24rpx;
}

.list-heading {
  padding: 36rpx 32rpx 12rpx;
  font-weight: 600;
}

.door-section {
  padding: 32rpx;
  border-bottom: 1rpx solid #dce2e0;
}

.door-heading {
  display: block;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.door-button {
  min-height: 96rpx;
  line-height: 96rpx;
  background: #167753;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.door-button::after {
  border: none;
}

.door-button[disabled] {
  background: #dce5e0;
  color: #718179;
}

.door-status {
  display: block;
  margin-top: 16rpx;
  min-height: 36rpx;
  font-size: 24rpx;
  color: #67726f;
  word-break: break-all;
}
