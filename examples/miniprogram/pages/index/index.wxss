.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 32rpx;
  border-bottom: 1rpx solid #dce2e0;
  word-break: break-all;
}

.arrow {
  color: #167753;
  font-size: 26rpx;
  flex-shrink: 0;
  margin-left: 24rpx;
}

.account-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  border-bottom: 1rpx solid #dce2e0;
}

.account-copy {
  flex: 1;
  min-width: 0;
}

.account-copy .hint {
  display: block;
  padding: 0 0 10rpx;
}

.account-id {
  font-size: 36rpx;
  font-weight: 600;
  word-break: break-all;
}

.list-heading {
  padding: 36rpx 32rpx 12rpx;
  font-weight: 600;
}

.door-section {
  padding: 32rpx;
  border-bottom: 1rpx solid #dce2e0;
}

.door-heading {
  display: block;
  margin-bottom: 20rpx;
  font-weight: 600;
}

.door-button {
  min-height: 96rpx;
  line-height: 96rpx;
  background: #167753;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.door-button::after {
  border: none;
}

.door-button[disabled] {
  background: #dce5e0;
  color: #718179;
}

.door-status {
  display: block;
  margin-top: 16rpx;
  min-height: 36rpx;
  font-size: 24rpx;
  color: #67726f;
  word-break: break-all;
}
