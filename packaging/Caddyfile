# Phone origin: https://rujibao.cn (TrustAsia cert in /etc/caddy/certs).
# stream.public_base / miniprogram apiBase must match.
#
# Tencent may intercept public HTTP/HTTPS for Host rujibao.cn until ICP 备案
# is cleared (DNSPod webblock). Raw IP on :80 keeps the old allowlist working.
#
# Install: sudo cp packaging/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy

{
	auto_https disable_redirects
	# Edge on some networks fails QUIC/HTTP3 with a generic TLS error while
	# Chrome falls back to TCP. Prefer h1/h2 until 备案/path is stable.
	servers {
		protocols h1 h2
	}
}

(common_routes) {
	@flv path_regexp flv ^/([A-Za-z0-9_-]+)\.flv$
	handle @flv {
		request_header -Range
		rewrite * /api/stream.flv?src={http.regexp.flv.1}
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
			header_up Host {upstream_hostport}
			header_down -Accept-Ranges
		}
	}

	@m3u8 path_regexp m3u8 ^/([A-Za-z0-9_-]+)\.m3u8$
	handle @m3u8 {
		rewrite * /api/stream.m3u8?src={http.regexp.m3u8.1}
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
			header_up Host {upstream_hostport}
		}
	}

	handle_path /hls/* {
		request_header -Range
		rewrite * /api/hls{uri}
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
			header_up Host {upstream_hostport}
			header_down -Accept-Ranges
		}
	}

	@vigil path /api/version /api/miniprogram/* /api/boarding/records /api/streams /api/streams/*/play /api/feeding /api/watering
	handle @vigil {
		reverse_proxy 127.0.0.1:18970
	}

	handle {
		respond 404
	}
}

rujibao.cn, www.rujibao.cn {
	tls /etc/caddy/certs/rujibao.cn_bundle.pem /etc/caddy/certs/rujibao.cn.key
	import common_routes
}

# IP / plain HTTP. Domain Host names redirect to HTTPS when they reach Caddy.
:80 {
	@domain host rujibao.cn www.rujibao.cn
	handle @domain {
		redir https://rujibao.cn{uri} permanent
	}
	import common_routes
}
