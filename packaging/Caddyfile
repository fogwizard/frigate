# WeChat cannot use go2rtc's query-string API or the LAN address.
# This file runs on the go2rtc machine (122.51.106.239) and exposes:
#   http://122.51.106.239/cam1.m3u8  →  127.0.0.1:1984/api/stream.m3u8?src=cam1
#   http://122.51.106.239/cam1.flv   →  127.0.0.1:1984/api/stream.flv?src=cam1
#   http://122.51.106.239/hls/*      →  127.0.0.1:1984/api/hls/*
#
# The master playlist's relative line "hls/playlist.m3u8?id=…" resolves to /hls/…
# and that playlist's "segment.ts?…" resolves to /hls/segment.ts. No body rewrite.
#
# The phone-facing origin is stream.public_base in config/default.yaml.
# It is http://122.51.106.239 today. When the certificate is ready, change
# that value to https://rujibao.cn and replace this site address `:80`
# with `rujibao.cn` (delete the auto_https off block so Caddy can issue TLS).
#
# Install on the server, then: sudo systemctl reload caddy

{
	auto_https off
}

:80 {
	@flv path_regexp flv ^/([A-Za-z0-9_-]+)\.flv$
	handle @flv {
		# WeChat ExoPlayer probes with Range: bytes=0-1023 then bytes=1024-.
		# go2rtc live FLV ignores Range and always restarts at the FLV header,
		# so the player aborts and spins. Strip Range and stream from the start.
		request_header -Range
		rewrite * /api/stream.flv?src={http.regexp.flv.1}
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
			header_up Host {upstream_hostport}
			header_down -Accept-Ranges
		}
	}

	@m3u8 path_regexp m3u8 ^/([A-Za-z0-9_-]+)\.m3u8$
	handle @m3u8 {
		rewrite * /api/stream.m3u8?src={http.regexp.m3u8.1}
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
			header_up Host {upstream_hostport}
		}
	}

	handle_path /hls/* {
		rewrite * /api/hls{uri}
		reverse_proxy 127.0.0.1:1984 {
			flush_interval -1
			header_up Host {upstream_hostport}
		}
	}

	# Mini-program login and queries only. 127.0.0.1:18970 is the FRP port on
	# this machine's loopback, so Vigil's web UI, recordings, and files are not
	# reachable from the public address.
	@vigil path /api/miniprogram/* /api/boarding/records /api/streams /api/streams/*/play /api/feeding /api/watering
	handle @vigil {
		reverse_proxy 127.0.0.1:18970
	}

	handle {
		respond 404
	}
}
