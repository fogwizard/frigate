# HTTPS edge for WeChat mini-program HTTP-FLV via go2rtc
# - Vigil FFmpeg restreams RTSP to go2rtc (:8554 publisher)
# - go2rtc serves HTTP-FLV on :1984
# - auth_request → Vigil GET /api/streams/auth?camera=&exp=&sig=
#
# Mini-program live-player src (from Vigil /api/streams/{cam}/play):
#   https://stream.example.com/cam1.flv?exp=...&sig=...
#
# WeChat requires a URL ending in .flv; nginx maps that to go2rtc's stream.flv API.
# Install: include this server{} in nginx, set ssl_certificate, reload.

upstream vigil_api {
    server 127.0.0.1:8970;
}

upstream go2rtc_api {
    server 127.0.0.1:1984;
}

server {
    listen 443 ssl http2;
    server_name stream.example.com;

    ssl_certificate     /etc/letsencrypt/live/stream.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/stream.example.com/privkey.pem;

    # /cam1.flv?exp=&sig=  →  go2rtc /api/stream.flv?src=cam1
    location ~ ^/(?<cam>[A-Za-z0-9_-]+)\.flv$ {
        set $flv_camera $cam;
        auth_request /_vigil_stream_auth;

        proxy_pass http://go2rtc_api/api/stream.flv?src=$flv_camera;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    location = /_vigil_stream_auth {
        internal;
        proxy_pass http://vigil_api/api/streams/auth?camera=$flv_camera&exp=$arg_exp&sig=$arg_sig;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
    }
}
